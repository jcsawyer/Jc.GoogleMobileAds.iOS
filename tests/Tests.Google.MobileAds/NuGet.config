<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear/>
        <add key="local-bindings" value="../../artifacts/smoke-packages"/>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json"/>
    </packageSources>
    <packageSourceMapping>
        <clear/>
        <packageSource key="local-bindings">
            <package pattern="Jc.GMA.iOS"/>
            <package pattern="Jc.UMP.iOS"/>
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*"/>
        </packageSource>
    </packageSourceMapping>
</configuration>
